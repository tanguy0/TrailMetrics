# TrailMetrics compute API — copy to .env for local work.
# Generate the three secrets with:  python -m api.keys

# --- Data ------------------------------------------------------------------
# Local Postgres (docker run -d -e POSTGRES_PASSWORD=tm -e POSTGRES_DB=trailmetrics \
#   -p 55432:5432 postgres:16-alpine):
DATABASE_URL=postgresql://postgres:tm@127.0.0.1:55432/trailmetrics
# Hosted: Supabase → Project settings → Database → Connection string. Prefer the
# connection *pooler* (port 6543) — a container that restarts often will exhaust
# direct connections.

# Streams go to Supabase Storage when these are set, and to disk otherwise.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=activity-streams
LOCAL_STREAM_ROOT=.streams

# --- Strava app ------------------------------------------------------------
# https://www.strava.com/settings/api — the Authorization Callback Domain must be
# the *web app's* host (localhost for local work), because the OAuth callback
# lands on Next.js, not on this API.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# --- Secrets ---------------------------------------------------------------
SESSION_SECRET=
ENCRYPTION_KEY=
# Must be identical to the web app's TRAILMETRICS_SERVICE_TOKEN.
SERVICE_TOKEN=
SESSION_TTL_DAYS=30

# --- Web app ---------------------------------------------------------------
WEB_APP_URL=http://localhost:3000
EXTRA_CORS_ORIGINS=

# --- Local development only ------------------------------------------------
# With DEV_MODE=true, every request is authenticated as DEV_ATHLETE_ID and no
# login is needed. Both are required; DEV_ATHLETE_ID alone does nothing, so this
# cannot be switched on by accident in production.
DEV_MODE=false
DEV_ATHLETE_ID=
LOG_LEVEL=INFO
