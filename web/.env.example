# TrailMetrics web app (Vercel). Copy to .env.local for local development.

# Where the Python compute API lives. Local: http://127.0.0.1:8000
# Hosted: the Railway/Render service URL.
TRAILMETRICS_API_URL=http://127.0.0.1:8000

# Must be identical to the API's SERVICE_TOKEN. Used server-to-server to turn a
# Strava authorization code into a session; never exposed to the browser.
TRAILMETRICS_SERVICE_TOKEN=

# This app's own public URL, used to build the Strava OAuth redirect.
# Local: http://localhost:3000 — Vercel: https://<your-app>.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# UI language: fr or en.
NEXT_PUBLIC_LANG=en
